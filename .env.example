# Copier en .env pour le développement local (ne jamais commiter .env)
ENVIRONMENT=development
DATABASE_URL=sqlite:///agata.db
# En développement, si ces deux valeurs sont absentes, des secrets persistants sont créés dans .agata_dev_secrets.json
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
ENCRYPTION_MASTER_KEY=
JWT_SECRET_KEY=
BASE_URL=http://localhost:8000
ADMIN_EMAIL=vous@exemple.com
FREE_CREDITS=20
SESSION_SECONDS=43200
MAX_OUTPUT_TOKENS=2048
TRUST_PROXY_HOPS=0
SCRUB_PII=1
# Migrations Alembic automatiques au démarrage (par défaut : oui en dev, non en production)
AUTO_MIGRATE=1

# --- E-mails (vérification d'adresse + mot de passe oublié) ---
# console : les e-mails sont affichés dans le terminal (idéal en local)
MAIL_PROVIDER=console
MAIL_FROM=AgAtA <vous@votredomaine.com>
RESEND_API_KEY=
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REQUIRE_VERIFIED_EMAIL=1
VERIFY_TOKEN_HOURS=24
RESET_TOKEN_MINUTES=60

# --- IA ---
MODERATOR_PROVIDER=gemini
MODERATOR_MODEL=
PLATFORM_GEMINI_KEY=
PLATFORM_OPENAI_KEY=
PLATFORM_ANTHROPIC_KEY=
PLATFORM_MISTRAL_KEY=
DEFAULT_OPENAI_MODEL=gpt-4o-mini
DEFAULT_ANTHROPIC_MODEL=claude-haiku-4-5
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
DEFAULT_MISTRAL_MODEL=mistral-small-latest

REDIS_URL=
OAUTH_GITHUB_ID=
OAUTH_GITHUB_SECRET=
OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=
